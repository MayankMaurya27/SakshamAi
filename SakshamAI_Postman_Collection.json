{
  "info": {
    "_postman_id": "7f8faee1-24db-4ef0-9b43-41c1eb48a608",
    "name": "Saksham AI Backend API Collection",
    "description": "Comprehensive Postman Collection for testing Saksham AI API endpoints. Features are grouped into structured folders covering System Health, Curriculum Browsing, RAG Q&A, Revision Summaries, MCQ Quizzes, Simplification, Document Management (User PDF pipeline), Standalone TTS, Hinenglish Localization, and Deprecated endpoints.\n\n### How to Use:\n1. Import this file into Postman.\n2. Ensure the backend server is running (`uvicorn app:app --reload --port 8000`).\n3. The `base_url` variable is pre-configured to `http://localhost:8000`.\n4. When uploading a custom PDF, note the `document_id` returned and set it in the Collection Variables so subsequent document-related requests work automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. System Health & Docs",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Performs a system health check to verify backend status, Ollama LLM availability, embedding model status, and audio system readiness."
          },
          "response": []
        },
        {
          "name": "Swagger UI Documentation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/docs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "docs"
              ]
            },
            "description": "Launches the interactive OpenAPI Swagger UI documentation in the browser."
          },
          "response": []
        },
        {
          "name": "Dyslexia UI Demo Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/static/dyslexia_demo.html",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "static",
                "dyslexia_demo.html"
              ]
            },
            "description": "Retrieve the static Dyslexia Demo HTML page designed to test accessibility font styles and display hints."
          },
          "response": []
        }
      ],
      "description": "Endpoints related to checking system status, viewing API docs, and testing static assets."
    },
    {
      "name": "2. Curriculum Browsing",
      "item": [
        {
          "name": "List Class Levels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/saksham/classes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "saksham",
                "classes"
              ]
            },
            "description": "Get all NCERT / CBSE curriculum class levels (Classes 6–10)."
          },
          "response": []
        },
        {
          "name": "List Subjects for a Class",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/saksham/subjects?class_level=8",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "saksham",
                "subjects"
              ],
              "query": [
                {
                  "key": "class_level",
                  "value": "8",
                  "description": "Target class level (e.g. 6-10)"
                }
              ]
            },
            "description": "List all subjects available for a given class level (e.g., Class 8 Science, Mathematics, Social Science)."
          },
          "response": []
        },
        {
          "name": "List Chapters for a Subject",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/saksham/chapters?class_level=8&subject=Science",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "saksham",
                "chapters"
              ],
              "query": [
                {
                  "key": "class_level",
                  "value": "8"
                },
                {
                  "key": "subject",
                  "value": "Science"
                }
              ]
            },
            "description": "Retrieve the full list of chapters available in the pre-built curriculum manifest for a given class level and subject."
          },
          "response": []
        },
        {
          "name": "List Topics (Chapters Alias)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/saksham/topics?class_level=10&subject=Science",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "saksham",
                "topics"
              ],
              "query": [
                {
                  "key": "class_level",
                  "value": "10"
                },
                {
                  "key": "subject",
                  "value": "Science"
                }
              ]
            },
            "description": "Alias endpoint to fetch chapter titles for class + subject."
          },
          "response": []
        }
      ],
      "description": "Browse classes, subjects, and chapters indexed in the core curriculum knowledge base."
    },
    {
      "name": "3. RAG Q&A (POST /ask)",
      "item": [
        {
          "name": "RAG Ask - Standard Learn Mode",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is force?\",\n  \"source\": \"saksham\",\n  \"class_level\": 8,\n  \"subject\": \"Science\",\n  \"chapter\": \"Exploring Forces\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/ask",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ask"
              ]
            },
            "description": "Performs a RAG search against the core NCERT database to give a grounded answer for a curriculum question."
          },
          "response": []
        },
        {
          "name": "RAG Ask - Beginner Mode",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is photosynthesis?\",\n  \"source\": \"saksham\",\n  \"class_level\": 7,\n  \"subject\": \"Science\",\n  \"chapter\": \"Nutrition in Plants\",\n  \"mode\": \"beginner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/ask",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ask"
              ]
            },
            "description": "Requests an answer formulated with simpler language and beginner level explanation style."
          },
          "response": []
        },
        {
          "name": "RAG Ask - Visual Mode",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Explain electric circuits.\",\n  \"source\": \"saksham\",\n  \"class_level\": 10,\n  \"subject\": \"Science\",\n  \"chapter\": \"Electricity\",\n  \"mode\": \"visual\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/ask",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ask"
              ]
            },
            "description": "Requests an answer emphasizing visual concepts, structural descriptions, and layout analogies."
          },
          "response": []
        },
        {
          "name": "RAG Ask - Dyslexia Profile with Audio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is force?\",\n  \"source\": \"saksham\",\n  \"class_level\": 8,\n  \"subject\": \"Science\",\n  \"chapter\": \"Exploring Forces\",\n  \"accessibility_profile\": \"dyslexia\",\n  \"include_audio\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/ask",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ask"
              ]
            },
            "description": "Applies a structured dyslexia-friendly formatting (accessibility hints) and generates point-wise TTS audio files for the answer."
          },
          "response": []
        },
        {
          "name": "RAG Ask - Uploaded Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is the main topic of this document?\",\n  \"source\": \"document\",\n  \"document_id\": \"{{document_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/ask",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ask"
              ]
            },
            "description": "Queries an uploaded user document index directly using RAG."
          },
          "response": []
        }
      ],
      "description": "Interact with Ollama RAG pipelines in standard, simplified, visual, accessibility (dyslexia), or user document modes."
    },
    {
