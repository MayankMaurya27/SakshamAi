    {
      "name": "6. Concept Simplification (POST /simplify)",
      "item": [
        {
          "name": "Simplify Complex Concept",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Explain democracy and republic.\",\n  \"source\": \"saksham\",\n  \"class_level\": 7,\n  \"subject\": \"Social Science\",\n  \"chapter\": \"The State, the Government, and You\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/simplify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "simplify"
              ]
            },
            "description": "Explains complex curriculum terms or formulas using analogical thinking, everyday terminology, and simpler syntax."
          },
          "response": []
        }
      ],
      "description": "Bust complex jargon and simplify curriculum ideas."
    },
    {
      "name": "7. User Document Pipeline",
      "item": [
        {
          "name": "Upload User PDF Document",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "description": "Provide path to your custom PDF file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "upload"
              ]
            },
            "description": "Extracts text, chunks content, generates embeddings, saves FAISS vector database partitions, creates a grounded summary, and builds interactive quiz questions for a custom PDF document. Save the returned `document_id` to test subsequent requests."
          },
          "response": []
        },
        {
          "name": "List Uploaded Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "documents"
              ]
            },
            "description": "Returns a list of metadata for all user-uploaded PDF documents."
          },
          "response": []
        },
        {
          "name": "Get Upload Details & Stored Quizzes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/document/{{document_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "document",
                "{{document_id}}"
              ]
            },
            "description": "Retrieves the detail metadata for a specific uploaded document ID, along with any pre-generated quiz questions saved during the upload phase."
          },
          "response": []
        },
        {
          "name": "Delete Upload & Vector Index",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/document/{{document_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "document",
                "{{document_id}}"
              ]
            },
            "description": "Deletes the physical PDF file, metadata, stored quizzes, and cleans up the associated FAISS vector index partition."
          },
          "response": []
        }
      ],
      "description": "Ingest, review, and delete custom PDF files. The pipeline generates vectors on the fly for complete RAG Q&A."
    },
    {
      "name": "8. Text to Speech (POST /audio)",
      "item": [
        {
          "name": "Standalone TTS Audio Generation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Force is a push or pull on an object.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/audio",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "audio"
              ]
            },
            "description": "Uses the pre-configured local Piper TTS synthesizer model to convert arbitrary English text into a downloadable `.wav` file."
          },
          "response": []
        },
        {
          "name": "Play/Retrieve WAV Audio File",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/audio/sample.wav",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "audio",
                "sample.wav"
              ]
            },
            "description": "Serves a generated TTS WAV audio file. Replace `sample.wav` with the actual file name returned in audio fields of previous API responses."
          },
          "response": []
        }
      ],
      "description": "Synthesize and serve speech audio for accessibility features using the local Piper engine."
    },
    {
