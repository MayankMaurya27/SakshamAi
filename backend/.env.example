# Saksham AI Backend Configuration

# Application
DEBUG=false

# Database
DATABASE_URL=sqlite:///./data/saksham.db

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=8192

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Offline bundle (run: python scripts/download_models.py --verify)
# EMBEDDING_MODEL_PATH=./data/models/multilingual-e5-small
# Remove ONNX extras if present: python scripts/download_models.py --cleanup
# Optional Jetson absolute path:
# EMBEDDING_MODEL_PATH=/opt/saksham/models/multilingual-e5-small
# Offline/Jetson: use local HuggingFace cache only (no network retries)
EMBEDDING_LOCAL_FILES_ONLY=true
PRELOAD_EMBEDDING_MODEL=true

# Retrieval
TOP_K=5
TOP_K_GUIDED=7
MAX_LLM_CONTEXT_CHARS=3200
MAX_LLM_CONTEXT_CHARS_GUIDED=7000
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

# Hybrid retrieval (Phase 1)
BM25_ENABLED=true
HYBRID_RETRIEVAL_ENABLED=true
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Offline bundle (run: python scripts/download_models.py)
# RERANK_MODEL_PATH=./data/models/ms-marco-MiniLM-L-6-v2
# Optional Jetson absolute path:
# RERANK_MODEL_PATH=/opt/saksham/models/ms-marco-MiniLM-L-6-v2
RERANK_LOCAL_FILES_ONLY=true
RETRIEVAL_CANDIDATE_COUNT=20
RRF_K=60
# Set false on Jetson Nano 4GB if memory is tight
# RERANK_ENABLED=false

# Piper TTS
PIPER_BINARY=piper
PIPER_MODEL_PATH=/path/to/piper/voice.onnx

# Quiz generation
QUIZ_DEFAULT_QUESTIONS=10
QUIZ_MIN_QUESTIONS=5
QUIZ_MAX_QUESTIONS=15
QUIZ_MAX_CONTEXT_CHARS=6500
OLLAMA_NUM_PREDICT_QUIZ=2048
QUIZ_LLM_MAX_ATTEMPTS=5
QUIZ_LLM_BATCH_SIZE=1
# Bump to invalidate stale quiz JSON cache on next server start (see services/cache_version.py)
QUIZ_CACHE_VERSION=v11-quality-gate

# Summary generation
# Bump to invalidate stale summary JSON cache on next server start
SUMMARY_CACHE_VERSION=v2-prose-grounded
SUMMARY_MAX_CONTEXT_CHARS=6500
SUMMARY_MAX_CHARS=5000
SUMMARY_MIN_WORDS=260
SUMMARY_TARGET_WORDS=380
SUMMARY_MIN_PARAGRAPHS=4
OLLAMA_NUM_PREDICT_SUMMARY=3200
